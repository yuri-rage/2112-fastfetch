{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/starman.ansi", // Path to text file
    "type": "file-raw",
    "width": 50,
    "height": 32
  },
  "display": {
      "separator": "  "
    },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "        \u001b[1;3;38;2;133;14;18m And the meek shall inherit the Earth...\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;20;26m┌──────────────────────Hardware───────────────────────┐\u001b[0m"
    },
    {
      "type": "title",
      "key": "  PC",
      "keyColor": "#23349c",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "host",
      "key": "   ├",
      "keyColor": "#26339b",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "   ├",
      "showPeCoreCount": true,
      "keyColor": "#28339b"
    },
    {
      "type": "gpu",
      "key": "   ├󰢮",
      "keyColor": "#2b329a"
    },
    {
      "type": "memory",
      "key": "   ├",
      "keyColor": "#2d329a"
    },
    {
      "type": "disk",
      "key": "   ├",
      "keyColor": "#303199",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "swap",
      "key": "   └",
      "keyColor": "#323099"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;20;26m├──────────────────────Software───────────────────────┤\u001b[0m"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "#353098"
    },
    {
      "type": "kernel",
      "key": "   ├",
      "keyColor": "#372f97"
    },
    {
      "type": "packages",
      "key": "   ├󰏖",
      "keyColor": "#3a2e97"
    },
    {
      "type": "terminal",
      "key": "   ├",
      "keyColor": "#3c2e96"
    },
    {
      "type": "shell",
      "key": "   └",
      "keyColor": "#3f2d96"
    },
    {
      "type": "de",
      "key": "  DE",
      "keyColor": "#412d95"
    },
    {
      "type": "lm",
      "key": "   ├󰙊",
      "keyColor": "#442c95"
    },
    {
      "type": "wm",
      "key": "   ├",
      "keyColor": "#462b94"
    },
    {
      "type": "wmtheme",
      "key": "   ├󰉼",
      "keyColor": "#492b93"
    },
    {
      "type": "font",
      "key": "   ├",
      "keyColor": "#4b2a93"
    },
    {
      "type": "cursor",
      "key": "   └󰆿",
      "keyColor": "#4e2992"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;20;26m├────────────────────Miscellaneous────────────────────┤\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "   ├",
      "keyColor": "#502992"
    },
    {
      "type": "localip",
      "key": "   ├󰲝",
      "showIpv4": true,
      "showPrefixLen": false,
      "keyColor": "#532891"
    },
    {
      "type": "media",
      "key": "   ├󰝚",
      "keyColor": "#552891",
      "format": "{title} - {album}"
    },
    {
      "type": "datetime",
      "key": "   └",
      "keyColor": "#582790",
      "format": "{month-pretty}/{day-pretty}/{year} - {hour-pretty}:{minute-pretty} {timezone-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;20;26m└──────────────────────────󰓏──────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "      \u001b[1;3;38;2;133;14;18m Our great computers fill the hallowed halls\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 20,
      "symbol": "star"
    }
  ]
}
